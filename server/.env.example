# PostgreSQL connection string (Neon, Render, Railway, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/roof_estimator?sslmode=require"

# Used to sign owner-panel JWT session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Seeded owner credentials (change these before going live)
ADMIN_USERNAME="admin"
